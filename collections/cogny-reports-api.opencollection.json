{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cogny Reports API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cogny.com/v1/reports",
            "params": [
              {
                "name": "warehouse_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_before",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List reports"
        },
        {
          "info": {
            "name": "Create a report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cogny.com/v1/reports",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Start an AI-generated growth report from a natural-language prompt over a connected warehouse."
        },
        {
          "info": {
            "name": "Get report status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cogny.com/v1/reports/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get report status"
        },
        {
          "info": {
            "name": "Cancel a report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cogny.com/v1/reports/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Cancel a report"
        },
        {
          "info": {
            "name": "Stream report generation (SSE)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cogny.com/v1/reports/:report_id/stream",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Server-Sent Events stream of report generation. Event types: status, query, result, insight, visualization, completed, error."
        },
        {
          "info": {
            "name": "Get report content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cogny.com/v1/reports/:report_id/content",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get report content"
        }
      ]
    }
  ],
  "bundled": true
}